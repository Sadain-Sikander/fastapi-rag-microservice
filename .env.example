# API Configuration
ENVIRONMENT=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB Configuration
CHROMA_COLLECTION_NAME=pdf_docs
CHROMA_PERSIST_DIRECTORY=./chroma_data

# LLM Model Configuration
PRIMARY_LLM_MODEL=gemini-2.0-flash
FALLBACK_LLM_MODEL=claude-3-5-sonnet-20241022
CHUNK_SIZE=500
TOP_K_RESULTS=3

# System Prompt
SYSTEM_PROMPT="Use ONLY the provided context to answer the user's question. If the answer is not contained within the context, state that explicitly."
